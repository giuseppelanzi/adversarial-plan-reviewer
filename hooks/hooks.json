{
  "description": "adversarial-plan-reviewer — persists the plan proposed by ExitPlanMode into .claude/plans/ of the current repo",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/save-plan.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
